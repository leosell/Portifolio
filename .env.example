# ---------------------------------------------------------------
# URL pública do site (usada em SEO, sitemap e Open Graph)
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://leonardocsell.com.br

# ---------------------------------------------------------------
# SMTP — envio do formulário de contato
# ---------------------------------------------------------------
# Gmail:   smtp.gmail.com  / porta 587
# Zoho:    smtp.zoho.com   / porta 465
# Outlook: smtp.office365.com / porta 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=leosell14@gmail.com

# ATENÇÃO (Gmail): não use a senha da conta.
# Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada).
SMTP_PASS=sua-senha-de-app-de-16-digitos

# Remetente que aparece no e-mail. Em geral igual ao SMTP_USER —
# provedores costumam recusar remetentes que você não controla.
MAIL_FROM=leosell14@gmail.com

# Caixa que recebe os contatos do site.
MAIL_TO=leosell14@gmail.com
